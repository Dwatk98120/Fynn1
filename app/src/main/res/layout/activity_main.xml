<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F7F5EF">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="First Sound Helper" android:textSize="32sp" android:textStyle="bold" android:layout_marginBottom="7dp"/>
<TextView android:id="@+id/androidBuildInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#53505D" android:layout_marginBottom="10dp" android:textIsSelectable="true"/>
<TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ready" android:textColor="#315C4C" android:layout_marginBottom="10dp"/>
<Button android:id="@+id/parentPcConnectionButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Parent PC Connection" android:layout_marginBottom="8dp"/>
<Button android:id="@+id/recordButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🎙️ Record speech"/>
<Button android:id="@+id/stopButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Stop" android:enabled="false"
        android:backgroundTint="#D9D2E8" 
        android:textColor="#4B4653" 
        android:textStyle="bold" />

<Button android:id="@+id/pilotReadinessButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🛡️ Caregiver Setup &amp; Pilot Readiness" android:layout_marginTop="8dp"/>
<Button android:id="@+id/communicationDictionaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🧠 Communication Interpretation Tools" android:layout_marginTop="8dp"/>
<Button android:id="@+id/studentToolsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🧩 Student Communication Tools" android:layout_marginTop="8dp"/>
<Button android:id="@+id/analyzeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Analyze speech" android:layout_marginTop="8dp"/>
<Button
    android:id="@+id/savedRecordingsButton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Saved Recordings"
    android:layout_marginTop="8dp"/>

<Button android:id="@+id/caregiverReviewButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Confirm / Correct Interpretation" android:layout_marginTop="10dp"/>
<Button android:id="@+id/analysisDetailsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Analysis Details" android:layout_marginTop="4dp"/>

<TextView android:id="@+id/result" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Results will appear here." android:textSize="18sp" android:padding="12dp" android:layout_marginTop="8dp"/>
</LinearLayout></ScrollView>
